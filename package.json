{
  "name": "harnessgate",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "description": "Self-hosted remote control plane for coding-agent harnesses (ACP client + thin web UI)",
  "scripts": {
    "start": "tsx server/index.ts",
    "dev": "tsx watch server/index.ts",
    "test": "node tests/web_static_check.mjs",
    "typecheck": "tsc --noEmit",
    "doctor": "node scripts/doctor.mjs",
    "import-registry": "node scripts/import-registry.mjs",
    "sync-history": "tsx scripts/sync-history.ts",
    "backfill-changes": "node scripts/backfill-changes.mjs"
  },
  "license": "ISC",
  "dependencies": {
    "@agentclientprotocol/sdk": "^1.4.0",
    "croner": "^10.0.1",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@types/node": "^26.6.1",
    "@types/ws": "^8.18.1",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  }
}
